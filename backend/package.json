{
  "name": "goldms-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server.ts",
    "dev:frontend": "npm run dev --prefix ../frontend",
    "dev": "concurrently -k -n backend,frontend -c cyan,magenta \"npm run dev:server\" \"npm run dev:frontend\"",
    "build": "node scripts/prepare-dist.js",
    "start": "tsx server.ts",
    "db:init": "tsx scripts/init-db.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mysql2": "^3.14.3",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "concurrently": "^9.2.1",
    "typescript": "~5.8.2"
  }
}
